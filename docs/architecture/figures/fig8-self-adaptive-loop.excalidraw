      "x": 120,
      "y": 472,
      "width": 304,
      "height": 19,
      "text": "① Log DB (log_event) — 개발자 Logging",
      "originalText": "① Log DB (log_event) — 개발자 Logging",
      "fontSize": 14.5,
      "fontFamily": 2,
